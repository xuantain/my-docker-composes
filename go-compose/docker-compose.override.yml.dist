services:
  # Backend: Go Gin API
  backend:
    environment:
      - DB_HOST=db
      - DB_PORT=3306
      - DB_USER=user
      - DB_PASSWORD=password
      - DB_NAME=test_db
    volumes:
      - path_to_your_backend:/app:cached
    hostname: todo.go.com
    networks:
      app-network:
        aliases:
          - todo.go.com

  # Database: MariaDB
  db:
    environment:
      - MYSQL_ROOT_PASSWORD=rootpassword
      - MYSQL_DATABASE=test_db
      - MYSQL_USER=user
      - MYSQL_PASSWORD=password
    volumes:
      - ./mariadb/mysql.cnf:/etc/mysql/conf.d/my.cnf:ro
      - ./mariadb/data:/var/lib/mysql

  # Frontend: React App
  frontend:
    environment:
      - NODE_ENV=production  # Build static files for Nginx
    volumes:
      - path_to_your_frontend:/app:cached

  # Nginx: Reverse Proxy and Static File Server
  nginx:
    ports:
      - "80:80"  # Exposes Nginx on host port 80
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf  # Mount custom config
      - path_to_your_frontend/build:/usr/share/nginx/html  # Mount React build files